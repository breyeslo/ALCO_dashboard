# --- Data -------------------------------------------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: comma-separated peer tickers shown in the equities table
# PEER_TICKERS=INDB,WBS,CFG
# LOOKBACK_YEARS=2

# --- Email (SMTP) -----------------------------------------------------------
# Gmail:      smtp.gmail.com, 587, STARTTLS, needs an App Password (2FA on)
# Office 365: smtp.office365.com, 587, STARTTLS (SMTP AUTH must be enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# EMAIL_CC=
